intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.
#import xxxx_libs += libhello%lib{hello}

# Public headers.
#
pub = [dir_path] ../include/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{cgltf}: libul{cgltf}: $pub/{$pub_hdrs}

# Private headers and sources as well as dependencies.
#
libul{cgltf}: {h c}{**} $impl_libs $intf_libs

libs{cgltf}: def{cgltf}: include = ($c.target.system == 'win32-msvc')
def{cgltf}: libul{cgltf}

# Build options.
#
out_pfx_inc = [dir_path] $out_root/include/
src_pfx_inc = [dir_path] $src_root/include/
out_pfx_src = [dir_path] $out_root/src/
src_pfx_src = [dir_path] $src_root/src/

c.poptions =+ "-I$out_pfx_src" "-I$src_pfx_src" \
              "-I$out_pfx_inc" "-I$src_pfx_inc"

if ($c.target.system == 'mingw32')
  c.loptions += -Wl,--export-all-symbols

# Upstream uses fopen() and strncpy(), which MSVC deprecates (upstream's test
# build defines the same).
#
if ($c.target.system == 'win32-msvc')
  c.poptions += -D_CRT_SECURE_NO_WARNINGS

# CGLTF_SPRINTF intentionally calls snprintf(NULL, 0, ...) to size the
# buffer. GCC -O3 reports that as -Wformat-truncation ("null destination
# pointer").
#
if ($c.id == 'gcc')
  c.coptions += -Wno-format-truncation

# Export options.
#
lib{cgltf}:
{
  c.export.poptions = "-I$out_pfx_inc" "-I$src_pfx_inc"
  c.export.libs = $intf_libs
}

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{cgltf}: bin.lib.version = "-$version.project_id"
else
  lib{cgltf}: bin.lib.version = "-$version.major.$version.minor"

# Don't install private headers.
#
h{*}: install = false
